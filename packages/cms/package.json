{
  "name": "@lumeland/cms",
  "version": "1.0.0",
  "description": "A framework-agnostic CMS",
  "homepage": "https://lume.land/cms/",
  "license": "MIT",
  "author": "Óscar Otero",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/lume/cms.git"
  },
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p . && pnpm run build:libs && cp -r static build",
    "build:libs": "rm -f static/libs/* && pnpm run build:markdown && pnpm run build:tiptap && pnpm run build:utils && pnpm run build:code && pnpm run build:terser",
    "build:markdown": "rollup libs/markdown.js -d static/libs/ -p @rollup/plugin-node-resolve",
    "build:tiptap": "rollup libs/tiptap.js -d static/libs/ -p @rollup/plugin-node-resolve -p @rollup/plugin-commonjs",
    "build:utils": "rollup libs/markup_util.js -d static/libs/ -p @rollup/plugin-node-resolve",
    "build:code": "rollup libs/code.js -d static/libs/ -p @rollup/plugin-node-resolve",
    "build:terser": "terser-glob static/libs/*.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "deno-std": "^1.6.0",
    "sharp": "^0.35.5",
    "temporal-polyfill": "^1.0.6",
    "ventojs": "^2.4.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "codemirror": "^6.0.2",
    "rollup": "^4.65.0",
    "terser": "^5.51.2",
    "terser-glob": "^1.2.1",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
