{
  "name": "@lumeland/cms",
  "version": "1.0.0-beta-2",
  "description": "A framework-agnostic CMS",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p . && node scripts/build.js",
    "build:libs": "rm -f ../static/libs/* && npm run build:markdown && npm run build:tiptap && npm run build:utils && npm run build:code && npm run build:normalize && npm run build:terser",
    "build:markdown": "rollup markdown.js -d ../static/libs/ -p @rollup/plugin-node-resolve",
    "build:tiptap": "ollup tiptap.js -d ../static/libs/ -p @rollup/plugin-node-resolve -p @rollup/plugin-commonjs",
    "build:utils": "rollup markup_util.js -d ../static/libs/ -p @rollup/plugin-node-resolve",
    "build:code": "rollup code.js -d ../static/libs/ -p @rollup/plugin-node-resolve",
    "build:normalize": "wget -O ../static/libs/modern-normalize.css https://unpkg.com/modern-normalize/modern-normalize.css",
    "build:terser": "terser-glob ../static/libs/*.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "fmt": "oxfmt ."
  },
  "dependencies": {
    "deno-std": "^1.5.3",
    "octokit": "^5.0.5",
    "sharp": "^0.35.5",
    "temporal-polyfill": "^1.0.6",
    "ventojs": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tiptap/core": "^3.14.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-mathematics": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "codemirror": "^6.0.2",
    "rollup": "^4.62.2",
    "terser": "^5.49.0",
    "terser-glob": "^1.2.1",
    "tiptap-markdown": "^0.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
